    {
      "id": 8,
      "title": "WebSocket Messages/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "ffzu77r9cglc0e" },
      "targets": [
        {
          "expr": "sum(rate(websocket_messages_total{job=\"QuizForge\"}[5m]))",
          "legendFormat": "Total Messages/sec"
        },
        {
          "expr": "sum by (event) (rate(websocket_messages_total{job=\"QuizForge\"}[5m]))",
          "legendFormat": "{{event}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line" }
        }
      }
    },
    {
      "id": 9,
      "title": "WebSocket Message Latency (P50, P95, P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "ffzu77r9cglc0e" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(websocket_message_duration_seconds_bucket{job=\"QuizForge\"}[5m])) by (le)) * 1000",
          "legendFormat": "P50 Latency"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(websocket_message_duration_seconds_bucket{job=\"QuizForge\"}[5m])) by (le)) * 1000",
          "legendFormat": "P95 Latency"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(websocket_message_duration_seconds_bucket{job=\"QuizForge\"}[5m])) by (le)) * 1000",
          "legendFormat": "P99 Latency"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line" }
        }
      }
    },
    {
      "id": 10,
      "title": "WebSocket Errors/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "ffzu77r9cglc0e" },
      "targets": [
        {
          "expr": "sum(rate(websocket_errors_total{job=\"QuizForge\"}[5m]))",
          "legendFormat": "Total Errors/sec"
        },
        {
          "expr": "sum by (event, error_type) (rate(websocket_errors_total{job=\"QuizForge\"}[5m]))",
          "legendFormat": "{{event}} - {{error_type}}"
        }
